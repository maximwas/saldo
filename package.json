{
  "name": "saldo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "icons": "pwa-assets-generator",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && eslint . && pnpm lint:comments",
    "format": "biome check --write . && eslint --fix .",
    "typecheck": "next typegen && tsc --noEmit",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:db": "supabase test db",
    "check": "biome check . && eslint . && pnpm lint:comments && pnpm typecheck && depcruise src --config .dependency-cruiser.cjs && knip && vitest run",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts && biome format --write src/types/database.types.ts",
    "prepare": "lefthook install",
    "lint:comments": "node scripts/check-sql-comments.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "6.0.2",
    "@pushforge/builder": "2.0.5",
    "@serwist/turbopack": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/query-async-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "compressorjs": "1.4.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.65.0",
    "motion": "14.3.0",
    "negotiator": "1.1.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "papaparse": "5.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-number-format": "5.4.5",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "uint8array-extras": "^1.6.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vite-pwa/assets-generator": "2.0.0",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "knip": "6.44.0",
    "lefthook": "2.2.2",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
