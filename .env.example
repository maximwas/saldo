# Copy to .env.local and fill in. Never commit real values: the repository is public.
# `pnpm preview` (workerd) reads runtime values from .dev.vars instead: the same keys, local values only.
# Cloudflare: NEXT_PUBLIC_* are Workers Builds build variables, the rest runtime secrets (architecture.md §7).
# Validated by src/lib/env.ts (schema: src/lib/env.schema.ts).

# Public site URL: http://localhost:3000 locally, the production domain in production
NEXT_PUBLIC_SITE_URL=
# Supabase API URL (local: `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key, starts with sb_secret_; server only
SUPABASE_SECRET_KEY=
# Bearer secret the Worker's Cron Trigger and pg_cron send to /api/cron/*, at least 32 characters (openssl rand -hex 32)
CRON_SECRET=
# Server log level: fatal, error, warn, info, debug, trace or silent; empty = debug locally, info in production
LOG_LEVEL=

# Phase 3, Web Push: VAPID key pair from `npx @pushforge/builder vapid` (private key = JWK JSON). Optional: empty = no push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phase 9, Google Calendar OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Web Analytics site token (dashboard → Web Analytics). Optional: empty = no analytics script
NEXT_PUBLIC_CF_BEACON_TOKEN=
