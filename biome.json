{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "e2e/**", "scripts/**", "*.{ts,mjs,cjs}", ".dependency-cruiser.cjs", "!e2e/.auth"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "expand": "auto" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        },
        "useBlockStatements": "error",
        "noNestedTernary": "error"
      },
      "performance": { "noBarrelFile": "error", "noReExportAll": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "src/components/ui/amount.component.tsx",
        "src/features/operations/components/operation-editor.component.tsx",
        "src/features/operations/components/receipt-field.component.tsx"
      ],
      "linter": { "rules": { "style": { "noNestedTernary": "off" } } }
    },
    {
      "includes": ["src/types/database.types.ts"],
      "javascript": { "formatter": { "expand": "always" } },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
